CAMERA_SOURCE=0
# Host devices mapped into the detector container.
CAMERA_DEVICE=/dev/video0
TPU_DEVICE=/dev/apex_0
FRAME_WIDTH=1280
FRAME_HEIGHT=720
MODEL_PATH=models/detector.tflite
LABELS_PATH=models/coco_labels.txt
DETECTION_CONFIDENCE=0.55
GATE_A_X=400
GATE_B_X=900
GATE_DISTANCE_METERS=6.0
MIN_GATE_SECONDS=0.12
MAX_GATE_SECONDS=4.0
MAX_MATCH_PIXELS=150
TRACK_TIMEOUT_SECONDS=0.8
OCR_INTERVAL_SECONDS=0.2
OCR_MIN_CONFIDENCE=55
OCR_MIN_VOTES=2
DATABASE_PATH=radar.db
# Compose uses /data/radar.db in a persistent volume; DATABASE_PATH is for native runs.
POST_MODE=offline
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
